+package io.agentic.shortener.web;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+@SpringBootTest(properties = "shortener.blocked-domains=evil.example,Phish.Test")
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class BlockedDomainIntegrationTest {
+
+    @Autowired
+    MockMvc mvc;
+
+    @Test
+    void rejectsBlockedDomainAndSubdomainsWithProblemDetail() throws Exception {
+        create("https://login.evil.example/reset")
+                .andExpect(status().isBadRequest())
+                .andExpect(header().string("Content-Type", containsString("application/problem+json")))
+                .andExpect(jsonPath("$.detail").value("Links to this domain are blocked by policy"));
+        create("https://PHISH.test/x").andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void lookalikeAndOtherDomainsAreUnaffected() throws Exception {
+        create("https://notevil.example/").andExpect(status().isCreated());
+        create("https://evil.example.com/").andExpect(status().isCreated());
+        create("https://example.org/").andExpect(status().isCreated());
+    }
+
+    private ResultActions create(String url) throws Exception {
+        return mvc.perform(post("/api/v1/links").contentType(MediaType.APPLICATION_JSON)
+                .content("{\"url\":\"" + url + "\"}"));
+    }
+}
