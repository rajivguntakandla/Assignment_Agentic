+package io.agentic.shortener.repository;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import io.agentic.shortener.domain.Link;
+import java.time.Instant;
+import java.util.List;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.data.domain.Limit;
+import org.springframework.test.context.ActiveProfiles;
+
+@SpringBootTest
+@ActiveProfiles("test")
+class LinkRepositoryRecentLinksTest {
+
+    private static final Instant BASE = Instant.parse("2024-01-01T00:00:00Z");
+
+    @Autowired
+    private LinkRepository linkRepository;
+
+    @Autowired
+    private ClickEventRepository clickEventRepository;
+
+    @BeforeEach
+    void cleanDatabase() {
+        clickEventRepository.deleteAll();
+        linkRepository.deleteAll();
+    }
+
+    @Test
+    void ordersByCreatedAtDescendingNotByInsertionOrder() {
+        linkRepository.save(newLink(2, BASE.plusSeconds(2)));
+        linkRepository.save(newLink(3, BASE.plusSeconds(3)));
+        linkRepository.save(newLink(1, BASE.plusSeconds(1)));
+
+        List<Link> result = linkRepository.findAllByOrderByCreatedAtDescIdDesc(Limit.of(10));
+
+        assertThat(codes(result)).containsExactly(code(3), code(2), code(1));
+    }
+
+    @Test
+    void equalTimestampsAreOrderedDeterministically() {
+        Instant same = BASE.plusSeconds(100);
+        linkRepository.save(newLink(1, same));
+        linkRepository.save(newLink(2, same));
+        linkRepository.save(newLink(3, same));
+
+        List<String> first = codes(linkRepository.findAllByOrderByCreatedAtDescIdDesc(Limit.of(10)));
+        List<String> second = codes(linkRepository.findAllByOrderByCreatedAtDescIdDesc(Limit.of(10)));
+
+        assertThat(first).containsExactlyInAnyOrder(code(1), code(2), code(3));
+        assertThat(second).isEqualTo(first);
+    }
+
+    @Test
+    void rowCountIsBoundedByLimit() {
+        linkRepository.saveAll(IntStream.rangeClosed(1, 30).mapToObj(n -> newLink(n, BASE.plusSeconds(n))).toList());
+
+        List<Link> result = linkRepository.findAllByOrderByCreatedAtDescIdDesc(Limit.of(7));
+
+        assertThat(result).hasSize(7);
+        assertThat(codes(result)).containsExactlyElementsOf(
+                IntStream.iterate(30, i -> i - 1).limit(7).mapToObj(LinkRepositoryRecentLinksTest::code).toList());
+    }
+
+    @Test
+    void returnsEmptyListWhenNoLinksExist() {
+        assertThat(linkRepository.findAllByOrderByCreatedAtDescIdDesc(Limit.of(20))).isEmpty();
+    }
+
+    @Test
+    void includesInactiveAndExpiredLinksBecauseTheyAreRetrievableByCode() {
+        // 30 links; the 10 newest are deactivated or expired. All are still retrievable via GET /{code},
+        // so with the identity visibility filter the 20 newest are returned, including those 10.
+        for (int n = 1; n <= 30; n++) {
+            Instant createdAt = BASE.plusSeconds(n);
+            Link link;
+            if (n > 20 && n % 2 == 0) {
+                link = newLink(n, createdAt);
+                link.deactivate();
+            } else if (n > 20) {
+                link = new Link(code(n), url(n), createdAt, createdAt.plusSeconds(1), null);
+            } else {
+                link = newLink(n, createdAt);
+            }
+            linkRepository.save(link);
+        }
+
+        List<Link> result = linkRepository.findAllByOrderByCreatedAtDescIdDesc(Limit.of(20));
+
+        assertThat(codes(result)).containsExactlyElementsOf(
+                IntStream.iterate(30, i -> i - 1).limit(20).mapToObj(LinkRepositoryRecentLinksTest::code).toList());
+    }
+
+    private static Link newLink(int n, Instant createdAt) {
+        return new Link(code(n), url(n), createdAt, null, null);
+    }
+
+    private static String code(int n) {
+        return String.format("rep%04d", n);
+    }
+
+    private static String url(int n) {
+        return "https://example.com/repo/" + n;
+    }
+
+    private static List<String> codes(List<Link> links) {
+        return links.stream().map(Link::getCode).toList();
+    }
+}
