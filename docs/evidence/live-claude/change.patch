+
+/**
+ * T3: the codebase has no security configuration, so no matcher change is needed. This test confirms that
+ * GET /api/v1/links gets exactly the same access-control outcome as GET /api/v1/links/{code}.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class LinkListAccessParityTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Autowired
+    private LinkRepository linkRepository;
+
+    @Autowired
+    private ClickEventRepository clickEventRepository;
+
+    @BeforeEach
+    void cleanDatabase() {
+        clickEventRepository.deleteAll();
+        linkRepository.deleteAll();
+    }
+
+    @Test
+    void unauthenticatedCallerGetsSameStatusFromListAsFromSingleLookup() throws Exception {
+        linkRepository.save(new Link("acc0001", "https://example.com/access",
+                Instant.parse("2024-01-01T00:00:00Z"), null, null));
+
+        int lookupStatus = mockMvc.perform(get("/api/v1/links/acc0001")).andReturn().getResponse().getStatus();
+        int listStatus = mockMvc.perform(get("/api/v1/links")).andReturn().getResponse().getStatus();
+
+        assertThat(lookupStatus).as("GET /api/v1/links/{code} is unauthenticated").isEqualTo(200);
+        assertThat(listStatus).as("GET /api/v1/links mirrors GET /api/v1/links/{code}").isEqualTo(lookupStatus);
+    }
+}
