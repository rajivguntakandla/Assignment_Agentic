+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class LinkListApiIntegrationTest {
+
+    private static final Instant BASE = Instant.parse("2024-01-01T00:00:00Z");
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Autowired
+    private ObjectMapper objectMapper;
+
+    @Autowired
+    private LinkRepository linkRepository;
+
+    @Autowired
+    private ClickEventRepository clickEventRepository;
+
+    @BeforeEach
+    void cleanDatabase() {
+        clickEventRepository.deleteAll();
+        linkRepository.deleteAll();
+    }
+
+    @Test
+    void returnsTopLevelArrayOrderedNewestFirst() throws Exception {
+        seed(2);
+        seed(3);
+        seed(1);
+
+        JsonNode body = list(get("/api/v1/links"));
+
+        assertThat(codes(body)).containsExactly(code(3), code(2), code(1));
+        assertNonIncreasingCreatedAt(body);
+    }
+
+    @Test
+    void returnsEmptyArrayWhenNoLinksExist() throws Exception {
+        JsonNode body = list(get("/api/v1/links"));
+
+        assertThat(body.size()).isZero();
+    }
+
+    @Test
+    void defaultLimitReturnsTwentyNewest() throws Exception {
+        seedRange(1, 25);
+
+        JsonNode body = list(get("/api/v1/links"));
+
+        assertThat(codes(body)).containsExactlyElementsOf(newest(25, 20));
+        assertNonIncreasingCreatedAt(body);
+    }
+
+    @Test
+    void explicitLimitReturnsThatManyNewest() throws Exception {
+        seedRange(1, 25);
+
+        JsonNode body = list(get("/api/v1/links").param("limit", "5"));
+
+        assertThat(codes(body)).containsExactlyElementsOf(newest(25, 5));
+    }
+
+    @Test
+    void limitLargerThanAvailableReturnsAll() throws Exception {
+        seedRange(1, 3);
+
+        JsonNode body = list(get("/api/v1/links").param("limit", "10"));
+
+        assertThat(codes(body)).containsExactlyElementsOf(newest(3, 3));
+    }
+
+    @Test
+    void limitOneIsAccepted() throws Exception {
+        seedRange(1, 3);
+
+        JsonNode body = list(get("/api/v1/links").param("limit", "1"));
+
+        assertThat(body.size()).isLessThanOrEqualTo(1);
+        assertThat(codes(body)).containsExactly(code(3));
+    }
+
+    @Test
+    void limitOneHundredReturnsHundredNewestOfOneHundredFifty() throws Exception {
+        seedRange(1, 150);
+
+        JsonNode body = list(get("/api/v1/links").param("limit", "100"));
+
+        assertThat(codes(body)).containsExactlyElementsOf(newest(150, 100));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"0", "101", "-1", "abc", "1.5", ""})
+    void invalidLimitIsRejectedWithProblemDetail(String value) throws Exception {
+        seed(1);
+        long before = linkRepository.count();
+
+        String json = mockMvc.perform(get("/api/v1/links").param("limit", value))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
+                .andExpect(jsonPath("$.status").value(400))
+                .andExpect(jsonPath("$.title").isNotEmpty())
+                .andReturn().getResponse().getContentAsString();
+
+        assertThat(objectMapper.readTree(json).isObject()).isTrue();
+        assertThat(json).doesNotContain(code(1)).doesNotContain(url(1));
+        assertThat(linkRepository.count()).isEqualTo(before);
+    }
+
+    @Test
+    void eachItemIsJsonEqualToSingleLinkLookup() throws Exception {
+        seed(1);
+        seedExpired(2);
+        seedInactive(3);
+
+        JsonNode body = list(get("/api/v1/links"));
+
+        assertThat(body.size()).isEqualTo(3);
+        for (JsonNode item : body) {
+            String single = mockMvc.perform(get("/api/v1/links/" + item.get("code").asText()))
+                    .andExpect(status().isOk())
+                    .andReturn().getResponse().getContentAsString();
+            assertThat(item).isEqualTo(objectMapper.readTree(single));
+        }
+    }
+
+    @Test
+    void listContainsExactlyTheLinksRetrievableByCodeAndLimitAppliesAfterVisibility() throws Exception {
+        seedRange(1, 20);
+        for (int n = 21; n <= 30; n++) {
+            if (n % 2 == 0) {
+                seedInactive(n);
+            } else {
+                seedExpired(n);
+            }
+        }
+        for (int n = 21; n <= 30; n++) {
+            mockMvc.perform(get("/api/v1/links/" + code(n))).andExpect(status().isOk());
+        }
+
+        JsonNode limited = list(get("/api/v1/links").param("limit", "20"));
+        assertThat(codes(limited)).containsExactlyElementsOf(newest(30, 20));
+
+        JsonNode all = list(get("/api/v1/links").param("limit", "100"));
+        assertThat(codes(all)).containsExactlyElementsOf(newest(30, 30));
+    }
+
+    @Test
+    void differentCallersReceiveTheSameList() throws Exception {
+        seedRange(1, 5);
+
+        JsonNode first = list(get("/api/v1/links").header("User-Agent", "caller-a")
+                .with(request -> {
+                    request.setRemoteAddr("10.0.0.1");
+                    return request;
+                }));
+        JsonNode second = list(get("/api/v1/links").header("User-Agent", "caller-b")
+                .with(request -> {
+                    request.setRemoteAddr("10.0.0.2");
+                    return request;
+                }));
+
+        assertThat(second).isEqualTo(first);
+    }
+
+    private JsonNode list(MockHttpServletRequestBuilder request) throws Exception {
+        String json = mockMvc.perform(request)
+                .andExpect(status().isOk())
+                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+                .andReturn().getResponse().getContentAsString();
+        JsonNode body = objectMapper.readTree(json);
+        assertThat(body.isArray()).as("top-level JSON array").isTrue();
+        return body;
+    }
+
+    private void assertNonIncreasingCreatedAt(JsonNode body) {
+        List<String> codes = codes(body);
+        for (int i = 0; i + 1 < codes.size(); i++) {
+            Instant earlier = linkRepository.findByCode(codes.get(i)).orElseThrow().getCreatedAt();
+            Instant later = linkRepository.findByCode(codes.get(i + 1)).orElseThrow().getCreatedAt();
+            assertThat(earlier).isAfterOrEqualTo(later);
+        }
+    }
+
+    private Link seed(int n) {
+        return linkRepository.save(newLink(n));
+    }
+
+    private Link seedExpired(int n) {
+        Instant createdAt = BASE.plusSeconds(n);
+        return linkRepository.save(new Link(code(n), url(n), createdAt, createdAt.plusSeconds(1), null));
+    }
+
+    private Link seedInactive(int n) {
+        Link link = newLink(n);
+        link.deactivate();
+        return linkRepository.save(link);
+    }
+
+    private void seedRange(int from, int to) {
+        linkRepository.saveAll(IntStream.rangeClosed(from, to).mapToObj(LinkListApiIntegrationTest::newLink).toList());
+    }
+
+    private static Link newLink(int n) {
+        return new Link(code(n), url(n), BASE.plusSeconds(n), null, null);
+    }
+
+    private static String code(int n) {
+        return String.format("lst%04d", n);
+    }
+
+    private static String url(int n) {
+        return "https://example.com/page/" + n;
+    }
+
+    private static List<String> newest(int highest, int count) {
+        return IntStream.iterate(highest, i -> i - 1).limit(count).mapToObj(LinkListApiIntegrationTest::code).toList();
+    }
+
+    private static List<String> codes(JsonNode array) {
+        List<String> result = new ArrayList<>();
+        array.forEach(node -> result.add(node.get("code").asText()));
+        return result;
+    }
+}
