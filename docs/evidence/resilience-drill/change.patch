+package io.agentic.shortener.web.dto;
+
+import java.util.List;
+
+public record BulkCreateLinksResponse(int created, int failed, List<ItemResult> results) {
+
+    public record ItemResult(int index, String status, LinkResponse link, ItemError error) {
+
+        public static ItemResult created(int index, LinkResponse link) {
+            return new ItemResult(index, "created", link, null);
+        }
+
+        public static ItemResult failed(int index, int httpStatus, String detail) {
+            return new ItemResult(index, "error", null, new ItemError(httpStatus, detail));
+        }
+    }
+
+    public record ItemError(int status, String detail) {
+    }
+}
