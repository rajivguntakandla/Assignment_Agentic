+package io.agentic.shortener.web;
+
+import io.agentic.shortener.config.ShortenerProperties;
+import io.agentic.shortener.service.ConflictException;
+import io.agentic.shortener.service.CreateLinkCommand;
+import io.agentic.shortener.service.CreateLinkResult;
+import io.agentic.shortener.service.InvalidUrlException;
+import io.agentic.shortener.service.LinkService;
+import io.agentic.shortener.web.dto.BulkCreateLinksRequest;
+import io.agentic.shortener.web.dto.BulkCreateLinksResponse;
+import io.agentic.shortener.web.dto.BulkCreateLinksResponse.ItemResult;
+import io.agentic.shortener.web.dto.CreateLinkRequest;
+import io.agentic.shortener.web.dto.LinkResponse;
+import io.swagger.v3.oas.annotations.Operation;
+import io.swagger.v3.oas.annotations.tags.Tag;
+import jakarta.validation.Valid;
+import java.util.ArrayList;
+import java.util.List;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * Bulk creation. Each item goes through {@link LinkService#create} in its own transaction, so validation rules
+ * are shared with the single-create endpoint and one failing item never affects the others.
+ */
+@RestController
+@RequestMapping("/api/v1/links/bulk")
+@Tag(name = "Links")
+public class BulkLinkController {
+
+    private final LinkService linkService;
+    private final ShortenerProperties properties;
+
+    public BulkLinkController(LinkService linkService, ShortenerProperties properties) {
+        this.linkService = linkService;
+        this.properties = properties;
+    }
+
+    @PostMapping
+    @Operation(summary = "Shorten up to 100 URLs",
+            description = "Returns 200 with one result per item, in request order (partial success).")
+    public BulkCreateLinksResponse create(@Valid @RequestBody BulkCreateLinksRequest request) {
+        List<ItemResult> results = new ArrayList<>(request.items().size());
+        int created = 0;
+        for (int i = 0; i < request.items().size(); i++) {
+            CreateLinkRequest item = request.items().get(i);
+            if (item == null) {
+                results.add(ItemResult.failed(i, 400, "item must not be null"));
+                continue;
+            }
+            try {
+                CreateLinkResult result = linkService.create(
+                        new CreateLinkCommand(item.url(), item.customAlias(), item.expiresAt(), null));
+                results.add(ItemResult.created(i, LinkResponse.from(result.link(), properties.baseUrl())));
+                created++;
+            } catch (InvalidUrlException e) {
+                results.add(ItemResult.failed(i, 400, e.getMessage()));
+            } catch (ConflictException e) {
+                results.add(ItemResult.failed(i, 409, e.getMessage()));
+            }
+        }
+        return new BulkCreateLinksResponse(created, results.size() - created, results);
+    }
+}
