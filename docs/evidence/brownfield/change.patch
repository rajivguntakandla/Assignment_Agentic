+package io.agentic.shortener.web;
+
+import static org.hamcrest.Matchers.nullValue;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class MaxClicksIntegrationTest {
+
+    @Autowired
+    MockMvc mvc;
+
+    @Autowired
+    ObjectMapper json;
+
+    @Test
+    void redirectsExactlyMaxClicksTimesThenReturnsGone() throws Exception {
+        String code = code(create("{\"url\":\"https://example.com/limited\",\"maxClicks\":2}")
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.maxClicks").value(2))
+                .andExpect(jsonPath("$.remainingClicks").value(2)));
+
+        mvc.perform(get("/" + code)).andExpect(status().isFound());
+        mvc.perform(get("/" + code)).andExpect(status().isFound());
+        mvc.perform(get("/" + code)).andExpect(status().isGone());
+        mvc.perform(get("/" + code)).andExpect(status().isGone());
+
+        mvc.perform(get("/api/v1/links/" + code))
+                .andExpect(jsonPath("$.clickCount").value(2))
+                .andExpect(jsonPath("$.remainingClicks").value(0));
+    }
+
+    @Test
+    void singleUseLinkWorksOnce() throws Exception {
+        String code = code(create("{\"url\":\"https://example.com/once\",\"maxClicks\":1}"));
+        mvc.perform(get("/" + code)).andExpect(status().isFound());
+        mvc.perform(get("/" + code)).andExpect(status().isGone());
+    }
+
+    @Test
+    void linksWithoutLimitBehaveAsBefore() throws Exception {
+        String code = code(create("{\"url\":\"https://example.com/unlimited\"}")
+                .andExpect(jsonPath("$.maxClicks", nullValue()))
+                .andExpect(jsonPath("$.remainingClicks", nullValue())));
+        for (int i = 0; i < 5; i++) {
+            mvc.perform(get("/" + code)).andExpect(status().isFound());
+        }
+        mvc.perform(get("/api/v1/links/" + code)).andExpect(jsonPath("$.clickCount").value(5));
+    }
+
+    @Test
+    void rejectsOutOfRangeLimits() throws Exception {
+        create("{\"url\":\"https://example.com\",\"maxClicks\":0}").andExpect(status().isBadRequest());
+        create("{\"url\":\"https://example.com\",\"maxClicks\":-3}").andExpect(status().isBadRequest());
+        create("{\"url\":\"https://example.com\",\"maxClicks\":1000001}").andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void idempotentReplayMustMatchLimit() throws Exception {
+        mvc.perform(post("/api/v1/links").header("Idempotency-Key", "limit-key")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\":\"https://example.com/k\",\"maxClicks\":5}"))
+                .andExpect(status().isCreated());
+        mvc.perform(post("/api/v1/links").header("Idempotency-Key", "limit-key")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\":\"https://example.com/k\",\"maxClicks\":5}"))
+                .andExpect(status().isOk());
+        mvc.perform(post("/api/v1/links").header("Idempotency-Key", "limit-key")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\":\"https://example.com/k\",\"maxClicks\":6}"))
+                .andExpect(status().isConflict());
+    }
+
+    private ResultActions create(String body) throws Exception {
+        return mvc.perform(post("/api/v1/links").contentType(MediaType.APPLICATION_JSON).content(body));
+    }
+
+    private String code(ResultActions result) throws Exception {
+        return json.readTree(result.andReturn().getResponse().getContentAsString()).get("code").asText();
+    }
+}
